# Monitoring and Observability Configuration
# Copy this to .env.production and .env.staging and fill in actual values

# Sentry - Error Tracking and Performance Monitoring
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_SAMPLE_RATE=0.1

# LogRocket - Session Replay and Bug Tracking
VITE_LOGROCKET_APP_ID=your-app-id

# Vercel Analytics
VITE_VERCEL_ANALYTICS_ID=your-analytics-id

# Custom Metrics Endpoint
VITE_METRICS_ENDPOINT=https://api.tutornest.com/api/metrics

# Monitoring Thresholds (in milliseconds/percentages)
VITE_API_RESPONSE_THRESHOLD=1000
VITE_VIDEO_LATENCY_THRESHOLD=200
VITE_ERROR_RATE_THRESHOLD=5

# Alert Configuration
VITE_ALERT_EMAIL=devops@tutornest.com
VITE_ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/your/webhook/url
VITE_ALERT_PAGERDUTY_KEY=your-pagerduty-integration-key

# Feature Flags for Monitoring
VITE_ENABLE_SENTRY=true
VITE_ENABLE_LOGROCKET=true
VITE_ENABLE_CUSTOM_METRICS=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_SESSION_REPLAY=true

# Data Retention
VITE_LOG_RETENTION_DAYS=30
VITE_METRICS_RETENTION_DAYS=30
VITE_REPLAY_RETENTION_DAYS=7
