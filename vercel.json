{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "app.tutornest.org" }],
      "destination": "https://app.knowledgefonsacademy.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 12 * * *"
    }
  ]
}
